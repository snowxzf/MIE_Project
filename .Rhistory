suppressPackageStartupMessages({
library(ggplot2)
library(tidyr)
library(dplyr)
})
install.packages(c("ggplot2", "tidyr", "dplyr"))
setwd("~/Library/Mobile Documents/com~apple~CloudDocs/uni resources/2W/mie286/project/code")
setwd("~/Library/Mobile Documents/com~apple~CloudDocs/uni resources/2W/mie286/project/code")
file.exists("export/trial_metrics_summary.csv")  # should be TRUE
source("~/Library/Mobile Documents/com~apple~CloudDocs/uni resources/2W/mie286/project/code/analysis_mie286.R")
