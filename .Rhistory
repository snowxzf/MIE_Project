# MIE 286 Final Project: Line Tracer: Feedback Type vs speed & accuracy
# This script reads per-trial metrics from export/trial_metrics_summary.csv
# (produce that file by running visualize_data.py on raw experiment CSVs).
# Experimental factor (two ACTIVE feedback types for main analysis):
#   - numerical: live numeric offset from target
#   - spatial-color: background color encodes proximity
# Rows with mode "no-feedback" are excluded from the main comparison because the
# assignment specifies two active feedback conditions (see §3.3).
# Dependent variables:
#   DV1 Speed — completion time (seconds), parsed from the trial filename.
#   DV2 Accuracy — trial score (0–100, from Line Tracer; higher = more accurate).
need <- c("ggplot2", "tidyr", "dplyr")
miss <- need[!vapply(need, requireNamespace, FUN.VALUE = logical(1), quietly = TRUE)]
if (length(miss)) {
stop(
"Install missing packages: install.packages(c(",
paste0('"', miss, '"', collapse = ", "),
"))"
)
}
suppressPackageStartupMessages({
library(ggplot2)
library(tidyr)
library(dplyr)
})
proj_root <- getwd()
if (!file.exists(file.path(proj_root, "export", "trial_metrics_summary.csv"))) {
stop("Set working directory to the project folder (containing export/). Current: ", proj_root)
}
csv_path <- file.path(proj_root, "export", "trial_metrics_summary.csv")
out_dir <- file.path(proj_root, "graphs")
dir.create(out_dir, showWarnings = FALSE)
# Parse completion time (seconds) from exported filename
parse_duration_sec <- function(filename) {
vapply(as.character(filename), FUN.VALUE = numeric(1), USE.NAMES = FALSE, function(s) {
if (is.na(s) || !nzchar(s)) return(NA_real_)
mmin <- regmatches(s, regexec("(\\d+)\\s*min\\s*(\\d+)(?:\\.(\\d+))?", s, ignore.case = TRUE, perl = TRUE))[[1]]
if (length(mmin) >= 3) {
base <- as.numeric(mmin[2]) * 60 + as.numeric(mmin[3])
if (length(mmin) >= 4 && !is.na(mmin[4]) && nzchar(mmin[4])) {
base <- base + as.numeric(paste0("0.", mmin[4]))
}
return(base)
}
three <- regmatches(s, regexec("(\\d+)\\.(\\d{1,2})\\.(\\d{1,2})", s, perl = TRUE))[[1]]
if (length(three) == 4) {
mins <- as.numeric(three[2])
secwhole <- as.numeric(three[3])
centi <- as.numeric(three[4])
return(mins * 60 + secwhole + centi / 100)
}
twos <- gregexpr("(\\d{1,3})\\.(\\d{1,3})", s, perl = TRUE)[[1]]
if (twos[1] != -1) {
frag <- regmatches(s, gregexpr("(\\d{1,3})\\.(\\d{1,3})", s, perl = TRUE))[[1]]
pick <- frag[length(frag)]
cap <- regmatches(pick, regexec("(\\d{1,3})\\.(\\d{1,3})", pick, perl = TRUE))[[1]]
if (length(cap) == 3) return(as.numeric(paste(cap[2], cap[3], sep = ".")))
}
NA_real_
})
}
raw <- read.csv(csv_path, stringsAsFactors = FALSE, check.names = FALSE)
trial <- raw %>%
mutate(
duration_sec = parse_duration_sec(.data$filename),
mode = trimws(as.character(.data$mode)),
participant = trimws(as.character(.data$participant)),
score = as.numeric(.data$score)
)
# One row per participant × mode (keep best score if duplicate uploads)
trial_dedup <- trial %>%
filter(!is.na(.data$score), !is.na(.data$duration_sec), nzchar(.data$participant)) %>%
group_by(.data$participant, .data$mode) %>%
slice_max(order_by = .data$score, n = 1, with_ties = FALSE) %>%
ungroup()
active <- trial_dedup %>% filter(.data$mode %in% c("numerical", "spatial-color"))
# Long format: Condition 1 = numerical, Condition 2 = spatial–color (for assumption figures)
assump <- active %>%
mutate(
condition = factor(
.data$mode,
levels = c("numerical", "spatial-color"),
labels = c(
"Condition 1: Numerical (time & accuracy)",
"Condition 2: Spatial–color (time & accuracy)"
)
)
) %>%
transmute(
condition,
`Time (s)` = .data$duration_sec,
`Accuracy (score)` = .data$score
) %>%
pivot_longer(-condition, names_to = "outcome", values_to = "value")
# Wide format for paired tests (within-subject: each person did both conditions)
paired <- active %>%
select(participant, mode, duration_sec, score) %>%
pivot_wider(
names_from = mode,
values_from = c(duration_sec, score),
names_sep = "___"
)
# Handle incomplete pairs
paired_complete <- paired %>%
filter(
!is.na(.data$`duration_sec___numerical`) & !is.na(.data$`duration_sec___spatial-color`)
)
cat("\nRESEARCH / STATISTICAL HYPOTHESES (for report)\n")
cat("H1 (speed):  Mean completion time differs between numerical and spatial-color feedback.\n")
cat("H2 (accuracy): Mean trial score differs between the two feedback types.\n")
cat("H3 (speed–accuracy): Completion time and score are correlated across trials\n")
cat("   (speed–accuracy tradeoff; expect negative correlation if faster → less accurate).\n")
cat("====================================================================\n\n")
cat("Sample (paired analysis): n = ", nrow(paired_complete), " participants with both active conditions.\n\n")
# Descriptive statistics
desc_active <- active %>%
group_by(mode) %>%
summarise(
n = n(),
duration_mean = mean(duration_sec),
duration_sd = sd(duration_sec),
duration_var = var(duration_sec),
score_mean = mean(score),
score_sd = sd(score),
score_var = var(score),
.groups = "drop"
)
cat("Descriptive statistics by feedback type (active conditions only)\n")
print(desc_active, width = 120)
cat("\n")
# --- Checklist: normality within each group (independent-samples perspective) ----
cat("Shapiro–Wilk by feedback type × outcome (raw scores in each group; H0: normal)\n")
shapiro_by_group <- assump %>%
group_by(.data$condition, .data$outcome) %>%
group_modify(~ {
v <- .x$value
n <- length(v)
if (n >= 3L && n <= 5000L) {
sw <- stats::shapiro.test(v)
tibble::tibble(n = n, statistic_W = unname(sw$statistic), p_value = sw$p.value)
} else {
tibble::tibble(n = n, statistic_W = NA_real_, p_value = NA_real_)
}
}) %>%
ungroup()
print(shapiro_by_group, n = Inf)
cat("\n")
# Curves for N(μ, σ) matched to each facet (visual match to histogram = rough normality)
curve_df <- assump %>%
group_by(.data$condition, .data$outcome) %>%
group_modify(~ {
v <- .x$value
m <- mean(v, na.rm = TRUE)
s <- stats::sd(v, na.rm = TRUE)
if (!is.finite(s) || s < 1e-9) s <- 1e-6
rg <- range(v, na.rm = TRUE)
pad <- max(diff(rg) * 0.25, 1, na.rm = TRUE)
xs <- seq(rg[1] - pad, rg[2] + pad, length.out = 200)
tibble::tibble(x = xs, y = stats::dnorm(xs, m, s))
}) %>%
ungroup()
p_hist_norm <- ggplot2::ggplot(assump, ggplot2::aes(x = value)) +
ggplot2::geom_histogram(
ggplot2::aes(y = ggplot2::after_stat(density)),
bins = 10,
fill = "#3d4f73",
alpha = 0.78,
color = "white",
linewidth = 0.3
) +
ggplot2::geom_line(
data = curve_df,
ggplot2::aes(x = .data$x, y = .data$y),
color = "#b22222",
linewidth = 0.9,
inherit.aes = FALSE
) +
ggplot2::facet_grid(condition ~ outcome, scales = "free") +
ggplot2::labs(
title = "Normality check (4 panels): histogram vs normal curve",
subtitle = "Each panel = one feedback type × one DV. Rough match suggests plausibility of normality for t procedures.",
x = NULL,
y = "Density"
) +
ggplot2::theme_bw(base_size = 11) +
ggplot2::theme(strip.text = ggplot2::element_text(size = 9))
ggplot2::ggsave(
file.path(out_dir, "r_check_normality_histograms_2x2.png"),
p_hist_norm,
width = 8.5,
height = 6,
dpi = 150
)
p_qq <- ggplot2::ggplot(assump, ggplot2::aes(sample = value)) +
ggplot2::stat_qq(alpha = 0.65, na.rm = TRUE) +
ggplot2::stat_qq_line(color = "#b22222", linewidth = 0.8, na.rm = TRUE) +
ggplot2::facet_grid(condition ~ outcome, scales = "free") +
ggplot2::labs(
title = "Q–Q plots by feedback type and outcome (4 panels)",
subtitle = "Points track the line if the sample is roughly normal in that group.",
x = "Theoretical quantiles",
y = "Sample quantiles"
) +
ggplot2::theme_bw(base_size = 11) +
ggplot2::theme(strip.text = ggplot2::element_text(size = 9))
ggplot2::ggsave(
file.path(out_dir, "r_check_qq_plots_2x2.png"),
p_qq,
width = 8.5,
height = 6,
dpi = 150
)
cat("Saved 2×2 assumption figures: r_check_normality_histograms_2x2.png, r_check_qq_plots_2x2.png\n\n")
# Assumption checks: normality of paired differences
diff_time <- paired_complete$`duration_sec___numerical` - paired_complete$`duration_sec___spatial-color`
diff_score <- paired_complete$`score___numerical` - paired_complete$`score___spatial-color`
cat("Shapiro–Wilk normality tests on paired differences (H0: normal)\n")
if (length(diff_time) >= 3 && length(diff_time) <= 5000) {
print(shapiro.test(diff_time))
} else {
cat("Shapiro skipped for time difference (need 3 <= n <= 5000).\n")
}
if (length(diff_score) >= 3 && length(diff_score) <= 5000) {
print(shapiro.test(diff_score))
} else {
cat("Shapiro skipped for score difference.\n")
}
cat("\n")
# Inferential tests: paired t-tests (two-tailed)
cat("Paired t-tests (two-tailed): numerical vs spatial-color\n")
tt_time <- t.test(
paired_complete$`duration_sec___numerical`,
paired_complete$`duration_sec___spatial-color`,
paired = TRUE
)
print(tt_time)
tt_score <- t.test(
paired_complete$`score___numerical`,
paired_complete$`score___spatial-color`,
paired = TRUE
)
print(tt_score)
cat("\n")
# Sensitivity: non-parametric paired alternative
cat("Wilcoxon signed-rank (sensitivity / if normality questionable)\n")
print(wilcox.test(
paired_complete$`duration_sec___numerical`,
paired_complete$`duration_sec___spatial-color`,
paired = TRUE
))
print(wilcox.test(
paired_complete$`score___numerical`,
paired_complete$`score___spatial-color`,
paired = TRUE
))
cat("\n")
# Speed–Accuracy: correlation on trial-level data
cat("Pearson correlation: duration_sec vs score (all active-condition trials)\n")
cor_pearson <- cor.test(active$duration_sec, active$score, method = "pearson")
print(cor_pearson)
cat("\nSpearman correlation (robust)\n")
print(cor.test(active$duration_sec, active$score, method = "spearman"))
cat("\n")
# Figures (for Results section)
p_box <- ggplot(active, aes(x = mode, y = duration_sec, fill = mode)) +
geom_boxplot(alpha = 0.85, outlier.shape = NA) +
geom_jitter(width = 0.12, alpha = 0.7, size = 2) +
scale_x_discrete(labels = c("numerical" = "Numerical", "spatial-color" = "Spatial–color")) +
scale_fill_manual(values = c("numerical" = "#4a36c0", "spatial-color" = "#18a050")) +
labs(
title = "Completion time by feedback type",
x = "Feedback type",
y = "Time (s)"
) +
theme_bw(base_size = 12) +
theme(legend.position = "none")
ggsave(file.path(out_dir, "r_feedback_duration_boxplot.png"), p_box, width = 6, height = 4, dpi = 150)
p_acc <- ggplot(active, aes(x = mode, y = score, fill = mode)) +
geom_boxplot(alpha = 0.85, outlier.shape = NA) +
geom_jitter(width = 0.12, alpha = 0.7, size = 2) +
scale_x_discrete(labels = c("numerical" = "Numerical", "spatial-color" = "Spatial–color")) +
scale_fill_manual(values = c("numerical" = "#4a36c0", "spatial-color" = "#18a050")) +
labs(
title = "Trial score (accuracy) by feedback type",
x = "Feedback type",
y = "Score (0–100)"
) +
theme_bw(base_size = 12) +
theme(legend.position = "none")
ggsave(file.path(out_dir, "r_feedback_score_boxplot.png"), p_acc, width = 6, height = 4, dpi = 150)
p_sa <- ggplot(active, aes(x = duration_sec, y = score, color = mode)) +
geom_point(size = 3, alpha = 0.8) +
geom_smooth(method = "lm", se = TRUE, linewidth = 0.6) +
scale_color_manual(
values = c("numerical" = "#4a36c0", "spatial-color" = "#18a050"),
labels = c("numerical" = "Numerical", "spatial-color" = "Spatial–color")
) +
labs(
title = "Speed–accuracy relationship",
x = "Completion time (s)",
y = "Score",
color = "Feedback type"
) +
theme_bw(base_size = 12)
ggsave(file.path(out_dir, "r_speed_accuracy_scatter.png"), p_sa, width = 7, height = 4.5, dpi = 150)
cat("Saved figures to ", normalizePath(out_dir, winslash = "/"), "\n", sep = "")
cat("\nDone. Copy console output (tests + Shapiro) into the report Appendix.\n")
p_sa <- ggplot(active, aes(x = duration_sec, y = score, color = mode)) +
geom_point(size = 3, alpha = 0.8) +
geom_smooth(method = "lm", se = TRUE, linewidth = 0.6) +
scale_color_manual(
values = c("numerical" = "#4a36c0", "spatial-color" = "#18a050"),
labels = c("numerical" = "Numerical", "spatial-color" = "Spatial–color")
) +
labs(
title = "Speed–accuracy relationship",
x = "Completion time (s)",
y = "Score",
color = "Feedback type"
) +
theme_bw(base_size = 12)
